# Copy to .env (never commit it). Next.js loads .env automatically; under PM2 the values in
# ecosystem.config.cjs / the shell environment win.

# --- Database (MySQL 8 / MariaDB 10.6+). Create the empty database first, then `npm run db:migrate`. ---
DATABASE_URL="mysql://uched:change-me@localhost:3306/uched"

# --- Secrets: REQUIRED when UCHED_REQUIRE_HTTPS=true (the server refuses to start with the dev defaults) ---
# Generate with: openssl rand -base64 48
UCHED_CONSENT_SECRET=
UCHED_IP_SALT=

# Set true behind HTTPS in production: rejects plain HTTP on /api/ismis/** and requires the secrets above.
UCHED_REQUIRE_HTTPS=false

# Enables POST /api/admin/import (CSV) via the X-Admin-Token header. Leave blank to disable.
UCHED_ADMIN_TOKEN=

# student ID numbers allowed to open the /admin dashboard after signing in (comma-separated). Default: 19020241.
# UCHED_ADMIN_IDS=19020241

# --- In-app AI assistant ("Ask" in the top bar). Leave the key blank to turn it off. ---
# Get a key at https://console.anthropic.com. Students' questions are sent to Anthropic (the Terms say so).
ANTHROPIC_API_KEY=
# UCHED_CHAT_MODEL=claude-opus-5-5     # a cheaper model, e.g. claude-sonnet-5-5 or claude-haiku-5-5, also works
# UCHED_CHAT_MAX_MESSAGES=20           # questions per student ...
# UCHED_CHAT_WINDOW_MINUTES=10         # ... per this many minutes

# --- Optional tuning (defaults shown) ---
# UCHED_TERMS_VERSION=2026-11-19-3
# UCHED_CONSENT_TTL_MINUTES=60
# UCHED_ISMIS_SESSION_IDLE_MINUTES=20
# UCHED_ISMIS_SESSION_MAX_MINUTES=60
# UCHED_ISMIS_SESSION_MAX=100
# UCHED_SCRAPE_MAX_CONCURRENT=2
# UCHED_SCRAPE_TIMEOUT_SECONDS=180

# --- ISMIS (values come from recon of the real pages; override only if ISMIS changes) ---
# UCHED_ISMIS_BASE_URL=https://ismis.usc.edu.ph
# UCHED_ISMIS_LOGIN_PATH=/Account/Login
# UCHED_ISMIS_OFFERED_PATH=/courseschedule/CourseScheduleOfferedIndex
# UCHED_ISMIS_SEARCH_PATH=/CourseSchedule/CourseScheduleOffered
# UCHED_ISMIS_PROSPECTUS_PATH=/prospectus/StudentProspectus
# UCHED_ISMIS_USERNAME_FIELD=Username
# UCHED_ISMIS_PASSWORD_FIELD=Password
# UCHED_ISMIS_MAX_PAGES=50
# UCHED_ISMIS_MIN_DELAY_MS=500
# UCHED_ISMIS_TIMEOUT_SECONDS=20
# UCHED_ISMIS_USER_AGENT="USChed/1.0 (student schedule planner; contact: you@example.com)"
